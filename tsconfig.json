{
  "compilerOptions": {
    "module": "commonjs",
    "esModuleInterop": true,
    "target": "es6",
    "moduleResolution": "node",
    "sourceMap": false,
    "rootDir": ".",
    "outDir": "dist",
    "types": ["node", "jest"],
    "skipLibCheck": true,
    "strict": true,
    "resolveJsonModule": true,
    "declaration": true
  },
  "lib": ["es2015"],
  "include": ["plugins/**/*", "models/**/*"],
  "exclude": ["node_modules", "dist", "test"]
}
